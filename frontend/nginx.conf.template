server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Limite de upload para scripts SQL e imagens de avatar (até 10MB)
    client_max_body_size 10M;

    # Compressão Gzip para assets estáticos da SPA React
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Proxy reverso da API REST para o container Backend
    # - No Docker Compose: BACKEND_UPSTREAM=http://backend:8000
    # - No Pod Kubernetes (Front+Back no mesmo Pod): BACKEND_UPSTREAM=http://127.0.0.1:8000
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }

    # Documentação Swagger UI e OpenAPI do FastAPI
    location /docs {
        proxy_pass ${BACKEND_UPSTREAM}/docs;
        proxy_set_header Host $host;
    }

    location /openapi.json {
        proxy_pass ${BACKEND_UPSTREAM}/openapi.json;
        proxy_set_header Host $host;
    }

    location /health {
        proxy_pass ${BACKEND_UPSTREAM}/api/health;
        proxy_set_header Host $host;
    }

    # Roteamento client-side da Single Page Application (React)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
