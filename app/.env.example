# ==============================================================================
# SQLArena - Modelo de Configurações de Ambiente (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# ==============================================================================

# Ambiente geral
ENVIRONMENT=local
APP_PORT=8000
SECRET_KEY=supersecretkey-local-dev-min-32-chars-change-in-production

# AWS Settings (Para Ministack: http://localhost:4566. Para AWS real: deixe vazio)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SQS Queues
SQS_QUEUE_NAME=sqlarena-submissions-queue
SQS_DLQ_NAME=sqlarena-submissions-queue-dlq

# RDS PostgreSQL
RDS_HOST=localhost
RDS_PORT=15432
RDS_USER=postgres
RDS_PASSWORD=postgrespassword
RDS_DB_NAME=app_db
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:15432/app_db

# ElastiCache Redis
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_URL=redis://localhost:16379/0
