# ==============================================================================
# SQLArena - Modelo de Configurações de Ambiente (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# ==============================================================================

# Ambiente geral
ENVIRONMENT=local
APP_PORT=8000
SECRET_KEY=supersecretkey-local-dev-min-32-chars-change-in-production
INTERNAL_API_KEY=sqlarena-internal-service-secret-key-32chars
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# 1. AWS DynamoDB (Banco NoSQL na AWS - preencha suas credenciais AWS / AWS Academy)
# Para usar o DynamoDB real na AWS, deixe DYNAMODB_ENDPOINT_URL vazio!
# Para testes 100% locais offline com Ministack, use DYNAMODB_ENDPOINT_URL=http://127.0.0.1:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
DYNAMODB_ENDPOINT_URL=
DYNAMODB_TABLE_NAME=sqlarena-submissions-log
DYNAMODB_CRUD_TABLE_NAME=sqlarena-crud-actions-log

# 2. PostgreSQL Principal em Container (Substitui o Amazon RDS)
RDS_HOST=127.0.0.1
RDS_PORT=15432
RDS_USER=postgres
RDS_PASSWORD=postgrespassword
RDS_DB_NAME=app_db
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@127.0.0.1:15432/app_db

# PostgreSQL Sandbox do Worker (Executado junto ao Worker)
SANDBOX_DATABASE_URL=postgresql://sandbox:sandboxpass@127.0.0.1:15433/sandbox_db

# 3. MinIO Object Storage em Container (Substitui o Amazon S3)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=sqlarena-questions-bucket

# 4. Apache Kafka em Container (Substitui o Amazon SQS)
QUEUE_BACKEND=kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_NAME=sqlarena-submissions-queue
KAFKA_DLQ_TOPIC_NAME=sqlarena-submissions-queue-dlq
KAFKA_CONSUMER_GROUP=sqlarena-workers-group

# 5. Redis em Container (Cache e Rate Limit de 5s)
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_URL=redis://127.0.0.1:16379/0
