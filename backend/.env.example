# Application & Security
PROJECT_NAME="SQLArena - SQL Education Platform"
SECRET_KEY="replace-with-a-secure-secret-key-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AWS & Ministack Settings
AWS_ENDPOINT_URL="http://localhost:4566"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"

# AWS Service Resources
S3_BUCKET_NAME="sqlarena-scripts"
SQS_QUEUE_NAME="sqlarena-submissions-queue"
DYNAMODB_TABLE_NAME="sqlarena-submission-logs"

# ElastiCache (Redis)
REDIS_HOST="localhost"
REDIS_PORT=16379
REDIS_CACHE_TTL_SECONDS=300

# RDS 1 (PostgreSQL - Metadata Database)
RDS1_HOST="localhost"
RDS1_PORT=15432
RDS1_USER="postgres"
RDS1_PASSWORD="postgrespassword"
RDS1_DB="app_db"

# RDS 2 (PostgreSQL - Isolated Execution Database)
RDS2_HOST="localhost"
RDS2_PORT=15432
RDS2_USER="postgres"
RDS2_PASSWORD="postgrespassword"
RDS2_DB="app_db"
RDS2_READONLY_USER="postgres"
RDS2_READONLY_PASSWORD="postgrespassword"
