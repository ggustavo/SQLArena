# ==============================================================================
# AWS REAL (AWS Academy Learner Lab): Provisiona tabelas no DynamoDB oficial
# ==============================================================================
# Copie este arquivo para 'credentials.tfvars' e cole suas credenciais ativas:
# terraform apply -var-file="envs/credentials.tfvars"
# ==============================================================================
project_name             = "sqlarena"
environment              = "aws"
is_local                 = false
aws_region               = "us-east-1"

aws_access_key           = "COLE_SEU_AWS_ACCESS_KEY_ID_AQUI"
aws_secret_key           = "COLE_SEU_AWS_SECRET_ACCESS_KEY_AQUI"
aws_session_token        = "COLE_SEU_AWS_SESSION_TOKEN_AQUI"

dynamodb_table_name      = "sqlarena-submissions-log"
dynamodb_crud_table_name = "sqlarena-crud-actions-log"
