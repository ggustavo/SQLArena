# ==============================================================================
# Credenciais Temporárias da AWS (AWS Academy Learner Lab ou Conta Pessoal)
# ==============================================================================
# Copie este arquivo para 'credentials.auto.tfvars' dentro de terraform/
# e preencha com os dados do botão "AWS Details" -> "AWS CLI":
#
# O arquivo 'credentials.auto.tfvars' está no .gitignore e NUNCA será enviado ao Git.
# Além disso, o Terraform carrega arquivos *.auto.tfvars AUTOMATICAMENTE!
# ==============================================================================

aws_access_key    = "COLE_AQUI_SEU_AWS_ACCESS_KEY_ID"
aws_secret_key    = "COLE_AQUI_SEU_AWS_SECRET_ACCESS_KEY"
aws_session_token = "COLE_AQUI_SEU_AWS_SESSION_TOKEN"
