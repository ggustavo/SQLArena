# ==============================================================================
# SQLArena - Variáveis de Ambiente para Docker Compose (.env.example)
# Copie para .env na raiz do projeto: cp .env.example .env
# ==============================================================================

# Credenciais da AWS (Para conexão com o Amazon DynamoDB na nuvem AWS)
# No AWS Academy Learner Lab, copie do menu "AWS Details -> AWS CLI":
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Endpoint opcional do DynamoDB:
# - Para AWS real: deixe vazio (DYNAMODB_ENDPOINT_URL=)
# - Para modo offline local (Ministack): use DYNAMODB_ENDPOINT_URL=http://host.docker.internal:4566
DYNAMODB_ENDPOINT_URL=

# Tabelas do DynamoDB
DYNAMODB_TABLE_NAME=sqlarena-submissions-log
DYNAMODB_CRUD_TABLE_NAME=sqlarena-crud-actions-log

# Segurança da Aplicação
SECRET_KEY=sqlarena-production-super-secret-key-32chars-min
INTERNAL_API_KEY=sqlarena-internal-service-secret-key-32chars

# PostgreSQL Principal (Substitui RDS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=app_db

# PostgreSQL Sandbox (Exclusivo do Worker)
SANDBOX_POSTGRES_USER=sandbox
SANDBOX_POSTGRES_PASSWORD=sandboxpass
SANDBOX_POSTGRES_DB=sandbox_db

# MinIO (Substitui Amazon S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_BUCKET_NAME=sqlarena-questions-bucket

# Apache Kafka (Substitui Amazon SQS)
KAFKA_TOPIC_NAME=sqlarena-submissions-queue
KAFKA_DLQ_TOPIC_NAME=sqlarena-submissions-queue-dlq
KAFKA_CONSUMER_GROUP=sqlarena-workers-group
